# ─── LLM Providers ────────────────────────────────────────────────────────────
# Set at least one of these:
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# LLM_PROVIDER: "claude" | "gemini" | "groq" | "offline"  (offline = deterministic heuristic, no API cost)
LLM_PROVIDER=offline
# Model name within the chosen provider:
#   claude: claude-sonnet-4-5
#   gemini: gemini-3.6-flash
#   groq:   openai/gpt-oss-120b or openai/gpt-oss-20b (14,400 req/day free on console.groq.com)
LLM_MODEL=claude-sonnet-4-5

# ─── Grounding Verifier ───────────────────────────────────────────────────────
# Use a different / cheaper model for the verifier to preserve independence from generator
VERIFIER_LLM_PROVIDER=offline
VERIFIER_LLM_MODEL=claude-haiku-4-5

# Maximum bullet regeneration attempts before dropping
VERIFIER_MAX_RETRIES=2

# ─── Decision Engine Thresholds ───────────────────────────────────────────────
THRESHOLD_GROUNDING=0.95
THRESHOLD_COMPLETENESS=0.85
THRESHOLD_EXECUTION=0.90

# ─── Gmail OAuth ──────────────────────────────────────────────────────────────
GMAIL_CREDENTIALS_PATH=credentials/gmail_oauth_credentials.json
GMAIL_TOKEN_PATH=credentials/gmail_token.json

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Scout Agent ──────────────────────────────────────────────────────────────
# Adzuna API (optional, falls back to web scrape if not set)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/jobflow.db

# ─── Storage Paths ────────────────────────────────────────────────────────────
RESUME_OUTPUT_DIR=./data/resumes
LOG_DIR=./data/logs

# ─── Application ──────────────────────────────────────────────────────────────
DEBUG=true
HOST=127.0.0.1
PORT=8000
